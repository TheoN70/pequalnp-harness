#!/usr/bin/env bash
# Usage: capmem [-m 5G] [-t 30m] <command> [args...]
# Runs a heavy command (livegpx, live7, liveg, live, lsg, lake build...) in its own systemd scope with a hard memory cap
# and a hard run time: past -t (default 30m, systemd time span: 90s, 25m, 6h; 0 or infinity = none) the whole scope,
# children included, is killed (SIGTERM, then SIGKILL). Why the cap: on 2026-11-25 20:30 a livegpx run grew to 24 GB,
# the kernel OOM-killed inside Claude Desktop's own cgroup and the app crashed for every lane; inside a capped scope only
# the command dies ("Killed", exit 137). Why the time limit: on 2026-11-27 a lane left circsat runs orphaned for 31 min
# on all 14 cores (Orchestrator). Research's deliberate long runs pass -t 6h (or -t 0).
# ponytail: 7 lanes x 4G = 28G of the 30G box (was 5G with 5 lanes); more only with a Master grant, one job at a time.
cap=4G t=30m
while :; do case $1 in -m) cap=$2; shift 2;; -t) t=$2; shift 2;; *) break;; esac; done
[ "$t" = 0 ] && t=infinity
# Free-memory guard (Orchestrator 2026-11-27: a 7 GB lean build with 5 GB available killed Claude Desktop at 19:16 UTC,
# as at 16:40): wait until MemAvailable - cap >= CAPMEM_RESERVE_G (default 4) GB, up to CAPMEM_WAIT_S (default 600) s,
# else exit 75 without running. ponytail: checked once at start; concurrent starts can still overcommit, heavy.lock covers the big ones.
cap_k=$(awk -v c="$cap" 'BEGIN{n=c+0; u=toupper(substr(c,length(c))); m=(u=="G")?1048576:(u=="M")?1024:(u=="K")?1:1/1024; print int(n*m)}')
need_k=$(( cap_k + ${CAPMEM_RESERVE_G:-4} * 1048576 )) waited=0
until [ "$(awk '/^MemAvailable/{print $2}' /proc/meminfo)" -ge "$need_k" ]; do
  [ "$waited" -ge "${CAPMEM_WAIT_S:-600}" ] && { echo "capmem: not enough free memory for -m $cap (+${CAPMEM_RESERVE_G:-4}G reserve) after ${waited}s, not started" >&2; exit 75; }
  [ "$waited" = 0 ] && echo "capmem: waiting for $cap + ${CAPMEM_RESERVE_G:-4}G free..." >&2
  sleep 10; waited=$((waited+10))
done
# ponytail: one shared slice caps the whole fleet (4th global OOM 2026-11-28 11:37: per-scope caps summed past RAM);
# runtime only, reset at reboot; CAPMEM_FLEET_MAX to change it.
systemctl --user set-property --runtime pnpfleet.slice MemoryMax="${CAPMEM_FLEET_MAX:-20G}" MemorySwapMax=0 2>/dev/null
exec systemd-run --user --scope --quiet --slice=pnpfleet.slice -p MemoryMax="$cap" -p MemorySwapMax=0 -p RuntimeMaxSec="$t" "$@"
